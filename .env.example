# ── LLM (obligatoire) ─────────────────────────────────────────────────────────
# Clé API Groq : https://console.groq.com/keys
GROQ_API_KEY=

# ── Credentials de test (optionnel) ───────────────────────────────────────────
# Laisse vide → l'agent génère des credentials aléatoires automatiquement
TEST_USERNAME=
TEST_PASSWORD=

# ── Browser (optionnel) ────────────────────────────────────────────────────────
BROWSER_HEADLESS=true          # false pour voir le navigateur s'ouvrir
DEFAULT_BROWSER=chromium       # chromium | firefox | webkit

# ── Timeouts (optionnel) ──────────────────────────────────────────────────────
DEFAULT_TIMEOUT=10             # secondes avant qu'une action échoue
PAGE_LOAD_TIMEOUT=30           # secondes avant qu'un chargement de page échoue

# ── Limites de tests (optionnel) ──────────────────────────────────────────────
MAX_SECTIONS_TO_TEST=20
MAX_TESTS_PER_PAGE=12
MAX_CRAWL_PAGES=30
MAX_SCENARIOS=15
BATCH_SIZE=2

# ── LLM avancé (optionnel) ────────────────────────────────────────────────────
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_POWERFUL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=2500
LLM_BATCH_PAUSE_SEC=4
LLM_RATE_LIMIT_WAIT=65

# ── Trello (optionnel) ────────────────────────────────────────────────────────
# Remplis les 3 valeurs pour créer automatiquement des cartes sur les tests FAILED
# Obtenir les clés : https://trello.com/app-key
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# ── Mission Control (optionnel) ───────────────────────────────────────────────
# Connecte l'agent au dashboard d'orchestration Mission Control
# https://github.com/builderz-labs/mission-control
# Laisse vide pour désactiver complètement
MISSION_CONTROL_URL=
MISSION_CONTROL_API_KEY=
